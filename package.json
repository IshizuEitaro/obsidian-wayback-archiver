{
	"name": "wayback-archiver",
	"version": "3.1.1",
	"description": "Automatically archives web links via Wayback Machine and appends or replaces with archived versions in notes.",
	"keywords": [
		"archiving",
		"obsidian-md",
		"obsidian-plugin",
		"wayback-machine"
	],
	"license": "MIT",
	"author": "ISHIZUE",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "vitest",
		"lint": "oxlint . --type-aware",
		"format": "oxfmt .",
		"format:check": "oxfmt --check ."
	},
	"dependencies": {
		"date-fns": "4.1.0"
	},
	"devDependencies": {
		"@types/node": "25.5.0",
		"esbuild": "0.28.1",
		"obsidian": "1.13.1",
		"oxfmt": "0.59.0",
		"oxlint": "1.74.0",
		"oxlint-tsgolint": "7.0.2001",
		"tslib": "2.8.1",
		"typescript": "7.0.2",
		"vite": "8.1.5",
		"vitest": "4.1.2"
	},
	"engines": {
		"node": ">=22",
		"pnpm": ">=11.19.0"
	},
	"packageManager": "pnpm@11.19.0"
}
